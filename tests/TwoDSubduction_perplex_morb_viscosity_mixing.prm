# This test tests for the implementation of HeFESTo lookup table in the plugin "visco plastic twod"
# In addition to the test TwoDSubduction_perplex_morb_viscosity:
#   1. recalibrated phase function values (devided by 0.8 and constrained between 0.0 and 1.0) 
#   2. mixing models from phases

set Dimension                              = 2
set Start time                             = 0
set End time                               = 0
set Use years in output instead of seconds = true
set Nonlinear solver scheme                = no Advection, no Stokes
set Max nonlinear iterations               = 1
set Timing output frequency                = 1
set Adiabatic surface temperature = 1073.0
set Additional shared libraries = $ASPECT_SOURCE_DIR/tester-build/visco_plastic_TwoD/libvisco_plastic_TwoD.so

# model geometry
subsection Geometry model
  set Model name = box
  subsection Box
    set X repetitions = 50
    set Y repetitions = 50
    set X extent      = 800e3
    set Y extent      = 800e3
  end
end

# Mesh refinement specifications
# for test: set all 3 to 0
# for visualization: set the adaptive refinement to 3
subsection Mesh refinement
  set Initial adaptive refinement        = 0
  set Initial global refinement          = 0
  set Time steps between mesh refinement = 0
end


# Temperature boundary and initial conditions
subsection Boundary temperature model
  set Fixed temperature boundary indicators   = left, right
  set List of model names = box
  subsection Box
    set Left temperature   = 273
    set Right temperature  = 2000  # 2000
  end
end
subsection Initial temperature model
  set Model name = function
  subsection Function
    set Coordinate system = cartesian
    set Variable names = x, y
    set Function constants = XMAX=800e3, Tl=273.0, Tr=2000 # 2000.0
    set Function expression = Tl * (x - XMAX)/(-XMAX) + Tr * x / XMAX
  end
end

# fields of composition
subsection Compositional fields
    set Number of fields = 4
    set Names of fields = spcrust,spharz,opcrust,opharz
    set Compositional field methods = field,field,field,field
end

# initial composition model, pick the crust only
subsection Initial composition model
    set List of model names = function
    set List of model operators = add
    subsection Function
        set Coordinate system = cartesian
        set Function expression = 1.0 ; 0.0; 0.0 ; 0.0
    end
end

# value for material model
# change thermal expansivity to 0.0
subsection Material model
    set Model name = visco plastic twod
    subsection Visco Plastic TwoD
        set Reference temperature = 273
        set Maximum viscosity = 1e24
        set Minimum viscosity = 1e18
        set Phase transition depths = background:670e3, spcrust: 80e3|670e3, spharz: 670e3
        set Phase transition widths = background:5e3, spcrust: 5e3|5e3, spharz:5e3
        set Phase transition temperatures = background:1662.0, spcrust: 1173.0|1662.0, spharz:1662.0
        set Phase transition Clapeyron slopes = background:-2e6, spcrust: 0.0|-2e6, spharz:-2e6
        # use the manually defined function for crust
        set Manually define phase method crust = 0.0
        set Thermal diffusivities = 1.0e-6, 1.0e-6, 1.0e-6, 1.0e-6,1.0e-6
        set Heat capacities = background:1000.0|2000.0, spcrust:1000.0|2000.0|3000.0, spharz:1000.0|2000.0, opcrust:1000.0, opharz:1000.0
        set Densities = 3300.0
        set Thermal expansivities = 0.0
        set Viscosity averaging scheme = harmonic
        set Viscous flow law = composite
        set Yield mechanism = drucker
        set Grain size = 1.0000e-02
        set Prefactors for diffusion creep = background:1.4250e-15|1.0657e-18, spcrust:5.0000e-21|1.4250e-15|1.0657e-18, spharz:1.4250e-15|1.0657e-18, opcrust:1.4250e-15, opharz:1.4250e-15
        set Grain size exponents for diffusion creep = background:3.0000e+00|3.0000e+00, spcrust:0.0000e+00|3.0000e+00|3.0000e+00, spharz:3.0000e+00|3.0000e+00, opcrust:3.0000e+00, opharz:3.0000e+00
        set Activation energies for diffusion creep = background:3.1700e+05|3.1700e+05, spcrust:0.0000e+00|3.1700e+05|3.1700e+05, spharz:3.1700e+05|3.1700e+05, opcrust:3.1700e+05, opharz:3.1700e+05
        set Activation volumes for diffusion creep = background:4.0000e-06|1.5000e-06, spcrust:0.0000e+00|4.0000e-06|1.5000e-06, spharz:4.0000e-06|1.5000e-06, opcrust:4.0000e-06, opharz:4.0000e-06
        set Prefactors for dislocation creep = background:6.859e-15, spcrust:6.859e-15, spharz:6.859e-15, opcrust:6.859e-15, opharz:6.859e-15
        set Stress exponents for dislocation creep = background:3.5, spcrust:3.5, spharz:3.5, opcrust:3.5, opharz:3.5
        set Activation energies for dislocation creep = background:480.0e3, spcrust:480.0e3, spharz:480.0e3, opcrust:480.0e3, opharz:480.0e3
        set Activation volumes for dislocation creep = background:11.0e-6, spcrust:11.0e-6, spharz:11.0e-6, opcrust:11.0e-6, opharz:11.0e-6
        set Angles of internal friction = 25.0,     25.00,     25.00,     25.00,     25.00
        set Cohesions = 50.e6,     50.e6,     50.e6,     50.e6,     50.e6
        set Use lookup table morb = true
        set Use phase rheology mixing = true
        set Phase rheology mixing models = 0, 1, 0, 0, 0  # 1: iso stress (weakest), 2: iso strain (strongest), 3: log (intermediate)
        subsection Lookup table morb
          set Data directory                                = $ASPECT_SOURCE_DIR/tests/
          set Material file names                           = perplex_morb_test_small.txt
          set Morb composition index = 1
          set Cutoff eclogite phase below = 0.25
          set Bilinear interpolation                        = true
          set Cutoff eclogite phase above T1 = 1673.0
          set Cutoff eclogite phase above P1 = 3.6e+09
          set Cutoff eclogite phase above T2 = 1173.0
          set Cutoff eclogite phase above P2 = 7.8e+09
          set Rewrite morb density = false
          set Eclogite phase divisor = 0.8
        end
    end
end



# Gravity model
subsection Gravity model
  set Model name = vertical
  subsection Vertical
    set Magnitude = 10.0
  end
end

# Post processing
subsection Postprocess
  set List of postprocessors = visualization, material statistics

  subsection Visualization
    set List of output variables = material properties, named additional outputs
    set Output format = vtu
    set Time between graphical output = 0.1e6
  end
end

subsection Solver parameters
  subsection Stokes solver parameters
    set Number of cheap Stokes solver steps = 0
    set Linear solver tolerance = 1.0
  end
end
