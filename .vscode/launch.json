{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            // Resolved by CMake Tools:
            "program": "${workspaceFolder}/build_main_collision/aspect-debug",
	    // *** replace --test by the name of the .prm file you want to run: ***
            "args": ["${workspaceFolder}/build_main_collision/test_model/hk04_olivine_dislocation_hydration_prefactor.prm"],
            "stopAtEntry": true,
	    // *** append to the path here if you want to run inside some directory like /cookbooks/ ***
            "cwd": "${workspaceFolder}/build_main_collision/test_model/",
            "environment": [
                {
                    // add the directory where our target was built to the PATHs
                    // it gets resolved by CMake Tools:
                    "name": "config",
                    "value": "Debug"
                }
            ]
        }
    ]
}
